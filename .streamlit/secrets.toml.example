# Copy these two lines into the Streamlit Cloud dashboard under
#   App settings -> Secrets
# Do NOT commit the real values; .streamlit/secrets.toml is gitignored.

# Your Neon (or Supabase) connection string. Use the POOLED endpoint if the
# provider offers one — it survives the database scaling to zero.
BOOKS_DB_URL = "postgresql://user:password@host/dbname?sslmode=require"

# The shared password both partners type to get in. Make it long.
BOOKS_PASSWORD = "change me"
